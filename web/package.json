{
  "name": "python-100-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs && vite",
    "build": "node scripts/prepare.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src scripts test *.ts *.mjs *.json index.html",
    "format:check": "prettier --check src scripts test *.ts *.mjs *.json index.html",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.11",
    "antd": "^6.6.3",
    "pyodide": "^314.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.2",
    "unocss": "^66.10.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "simple-git-hooks": {
    "pre-commit": "pnpm --dir web exec lint-staged --config lint-staged.config.mjs"
  }
}
